# ==================== DATABASE ====================
DATABASE_URL=postgresql://app_user:secure_password_here@localhost:5432/transformerpath
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transformerpath
DB_USER=app_user
DB_PASSWORD=secure_password_here

# ==================== NODE ENVIRONMENT ====================
NODE_ENV=production
PORT=3001

# ==================== JWT / AUTHENTICATION ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=24h

# ==================== STRIPE PAYMENTS ====================
# Required on Netlify for directory/sponsor self-serve checkout
# (functions/create-checkout.js). Alternatively paste Payment Links
# into payments-config.js and leave this empty.
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==================== SENDGRID EMAIL ====================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@transformerpath.com
SENDGRID_FROM_NAME=TransformerPath

# ==================== APPLICATION ====================
APP_URL=https://transformerpath.com
APP_NAME=TransformerPath
APP_LOGO_URL=https://transformerpath.com/logo.svg

# ==================== ADMIN ====================
ADMIN_EMAIL=admin@transformerpath.com
SUPPORT_EMAIL=support@transformerpath.com

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_FORMAT=json

# ==================== CORS ====================
CORS_ORIGIN=https://transformerpath.com

# ==================== AWS S3 (for file uploads) ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=transformerpath-uploads

# ==================== ANALYTICS ====================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token

# ==================== EVENTREGISTRY API (for daily intel) ====================
EVENTREGISTRY_API_KEY=your_eventregistry_key
NEWS_API_KEY=your_newsapi_key

# ==================== SLACK NOTIFICATIONS ====================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==================== DOCKER ====================
DOCKER_BUILDKIT=1
