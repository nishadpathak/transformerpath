{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://transformerpath.com/sourced-facility.schema.json",
  "title": "Sourced facility",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "facility_id",
    "company_id",
    "site",
    "city",
    "country",
    "status",
    "source_url",
    "source_type",
    "source_checked_at",
    "evidence_quote"
  ],
  "properties": {
    "facility_id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "site": { "type": "string" },
    "city": { "type": "string" },
    "country": { "type": "string" },
    "status": { "enum": ["SOURCED", "UNCLEAR", "TO_RESEARCH"] },
    "source_url": { "type": "string", "minLength": 1 },
    "source_type": {
      "enum": ["OFFICIAL_COMPANY", "REGULATOR", "FREE_ZONE_REGISTRY", "THIRD_PARTY"]
    },
    "source_checked_at": { "type": "string", "minLength": 1 },
    "evidence_quote": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "SOURCED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "source_type": { "enum": ["OFFICIAL_COMPANY", "REGULATOR", "FREE_ZONE_REGISTRY"] }
        }
      }
    }
  ]
}
