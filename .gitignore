# OS junk
.DS_Store
Thumbs.db
.claude/
# Dependencies — never track
node_modules/
scratch/
# Secrets — never commit
.env
*.token
secrets.txt
# Archive — old files not needed in repo
archive/
# Internal strategy / setup notes — kept local, never published or pushed.
# (netlify.toml also 404s /_docs/* in case the folder is deployed directly.)
_docs/
*.md

# Stale early-August snapshot of the site — superseded by the top-level pages.
transformerpath-site/

# Stale legacy snapshot of a PREVIOUS iteration of the site (old intel pages
# with a "refreshed daily" cadence, _synctmp/, site-archive/, the legacy
# mega-menu nav, an "Elin" voice and long-dead claims). Superseded by the
# top-level pages. Blocked at the Netlify layer too (see netlify.toml).
Transformer Equipments/
Transformer Radiators/

# Manuscripts, data dumps and anything else that must never be published
# or committed. Blocked at the Netlify layer too (see netlify.toml).
_private/
*.pdf
*.sql
*.xlsx


# Generated public deploy artifact — assembled by build-dist.js
dist/

# Private assets outside repo
../private_assets/
# Archived Intel snapshots
archive/intel_snapshots/

# Office documents, archives and key material never belong in the site repo.
# (*.docx was not covered — the Design Manual in "Transformer Equipments/" would
# have been committed had that folder not been gitignored.) .netlify/ holds
# the local CLI site link.
*.docx
*.doc
*.zip
*.pem
*.key
.netlify/

# iCloud Drive / macOS conflict copies ("index 2.html", "usa 2/"). The site folder
# lives in iCloud, and concurrent writes on 10 Sept produced 83 of them. No legitimate
# path in this site ends in " <number>", so these patterns cannot hide real content.
* [0-9]
* [0-9].*
* [0-9][0-9]
* [0-9][0-9].*
